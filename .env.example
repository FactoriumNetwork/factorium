# Factorium — Attestation Marketplace Protocol
# Configuration

# API server port (default: 3099, Render overrides to 10000)
PORT=3099

# Supabase PostgreSQL connection (required for data persistence)
# Get from Supabase dashboard → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Marketplace fee percentage (default: 10)
MARKETPLACE_FEE_PERCENT=10

# Auto-seed signing key (ed25519 private key, raw PEM or base64-encoded PEM).
# Must match the public key of a registered verifier. Without this, daily
# auto-seeding is skipped entirely (unsigned attestations are never seeded).
# Generate a keypair by registering a verifier without a publicKey:
#   POST /verifiers  ->  response includes privateKeyPem (shown once)
# SEED_VERIFIER_PRIVATE_KEY=

# Maximum attestation age before auto-expiry in seconds (default: 90 days)
MAX_ATTESTATION_AGE=7776000

# Lightning Network — enables real Bitcoin deposits and withdrawals
# Without this, the internal ledger works but transactions are not backed by Bitcoin.
#
# Recommended: Alby (getalby.com) — self-custodial, no KYC, 0% added fees
#   1. Sign up at https://getalby.com/auth/users/new
#   2. Go to https://getalby.com/dashboard → Developers → Access Tokens
#   3. Create an access token with "invoices" and "payments" scopes
#   4. Set ALBY_ACCESS_TOKEN below
#
# ALBY_ACCESS_TOKEN=
#
# Alternatives:
# OPENNODE_API_KEY=
# LNBITS_ADMIN_KEY=
# LNBITS_URL=https://legend.lnbits.com

# x402 payments (HTTP 402) — USDC on Base, settled via an x402 facilitator.
# Disabled by default; when disabled every route behaves as before (Lightning /
# internal ledger only). When enabled, these routes require a PAYMENT-SIGNATURE:
#   GET  /attestations                  -> $0.001
#   POST /attestations/:id/purchase     -> attestation price (stored units = cents USD)
#   POST /bounties                      -> bounty reward from request body (cents USD)
# and the MCP tool query_attestation costs $0.001 per call.
# X402_ENABLED=false
#
# CAIP-2 network. eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base (mainnet).
# X402_NETWORK=eip155:84532
#
# Base address that receives USDC payments (required when X402_ENABLED=true).
# X402_PAY_TO=0xYourAddressHere
#
# Facilitator that verifies and settles payments. The default is the keyless
# public facilitator, fine for Base Sepolia testing.
# X402_FACILITATOR_URL=https://x402.org/facilitator
#
# Optional: CDP hosted facilitator (mainnet-ready). NOTE: JWT auth for the CDP
# facilitator is not wired yet (see TODO in src/payments/x402.ts) — setting
# these currently only produces a startup warning.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
