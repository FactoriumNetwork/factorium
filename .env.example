# Factorium — Attestation Marketplace Protocol
# Configuration

# API server port (default: 3099, Render overrides to 10000)
PORT=3099

# Database path (default: ./data/marketplace.db)
DATABASE_PATH=./data/marketplace.db

# Marketplace fee percentage (default: 10)
MARKETPLACE_FEE_PERCENT=10

# Maximum attestation age before auto-expiry in seconds (default: 90 days)
MAX_ATTESTATION_AGE=7776000

# Lightning Network — enables real Bitcoin deposits and withdrawals
# Without this, the internal ledger works but transactions are not backed by real Bitcoin.
#
# Option A: LNBits (recommended, free to set up)
#   1. Go to https://legend.lnbits.com and create a wallet
#   2. Copy the Admin Key from your wallet's API info page
#   3. Set LNBITS_ADMIN_KEY below
#   OR self-host LNBits and set LNBITS_URL
#
# Option B: OpenNode (opennode.com)
#   1. Sign up at https://opennode.com
#   2. Generate an API key in your dashboard
#   3. Set OPENNODE_API_KEY below
#
# LNBITS_ADMIN_KEY=
# LNBITS_URL=https://legend.lnbits.com
# OPENNODE_API_KEY=
